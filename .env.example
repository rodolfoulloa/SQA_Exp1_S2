# Opcional: docker compose funciona sin este archivo usando los valores por defecto de abajo.
# Para cambiarlos, copiar a .env y editar. Nunca subir .env al repositorio.

# Credenciales MySQL compartidas entre el contenedor mysql y el backend
DB_USER=pixelmeet
DB_PASSWORD=game2026
DB_ROOT_PASSWORD=root2026

# Clave HMAC del JWT en Base64 (minimo 256 bits). Vacia = la API genera una aleatoria al iniciar.
# Para fijarla: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Clave del keystore PKCS12 con el certificado TLS
SSL_KEYSTORE_PASSWORD=cert2026
# Nombres e IPs que incluira el certificado autofirmado (agregar la IP publica de la VM)
CERT_CN=pixelmeet.local
CERT_SAN=dns:localhost,ip:127.0.0.1

# Claves de los usuarios iniciales de la aplicacion (solo al crear la BD por primera vez)
SEED_ADMIN_PASSWORD=Admin123!
SEED_GAMER_PASSWORD=Gamer123!
