# Copiar a .env y completar (o ejecutar ./scripts/generar-env.sh). Nunca subir .env al repositorio.
DB_USER=pixelmeet
DB_PASSWORD=cambiar-por-una-clave-larga
DB_ROOT_PASSWORD=cambiar-por-otra-clave-larga

# Clave HMAC del JWT en Base64 (minimo 256 bits). Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Clave del keystore PKCS12 con el certificado TLS
SSL_KEYSTORE_PASSWORD=cambiar-por-una-clave-larga
# Nombres e IPs que incluira el certificado autofirmado (agregar la IP publica de la VM)
CERT_CN=pixelmeet.local
CERT_SAN=dns:localhost,ip:127.0.0.1

# Claves de los usuarios iniciales (solo se usan al crear la BD por primera vez)
SEED_ADMIN_PASSWORD=Admin123!
SEED_GAMER_PASSWORD=Gamer123!
